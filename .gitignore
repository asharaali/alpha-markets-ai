# Secrets — never commit.
# Deliberately broad: the credential installer writes timestamped .env backups, and one of
# those backups holds the Kalshi private key. Listing only `.env` left them exposed to a
# `git add -A`, which is precisely the mistake this pattern has to make impossible.
backend/.env
backend/.env.*
!backend/.env.example
*.pem
*.key

# Python
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Runtime data: SQLite database, downloaded feeds, fitted model artifacts, accounts
backend/data/
backend/static/**/*.map

# Local tooling
bin/
node_modules/
*.log

# OS
.DS_Store
