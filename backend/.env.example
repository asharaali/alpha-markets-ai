# ---------------------------------------------------------------------------
# Alpha Markets — configuration
#
# The research side of this app needs NO API KEYS AT ALL. nflverse, Kalshi
# market data and Open-Meteo are all free and unauthenticated. Copy this file
# to .env and you are done.
#
# Keys are only needed to place real orders (Kalshi) or to cross-check prices
# against sportsbooks (The Odds API). Both are optional.
# ---------------------------------------------------------------------------

# ---- Kalshi (OPTIONAL — only for real-money order placement) ----
# Get these at https://kalshi.com -> Account -> API Keys. Kalshi issues a key ID
# and an RSA private key; paste the PEM with literal \n between lines, or use a
# multi-line value if your host supports it.
# WITHOUT these, everything still works: market data is public and all trading
# runs in paper mode.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY=

# ---- Live trading gates (all three must pass before a real order is placed) ----
LIVE_TRADING_ENABLED=false
# Must equal the username you log in with, in lowercase.
LIVE_TRADING_USER=
# Hard ceilings the interface cannot raise.
HARD_MAX_STAKE=25
HARD_DAILY_CAP=100

# ---- The Odds API (OPTIONAL — sportsbook cross-check) ----
# Free tier at https://the-odds-api.com (500 requests/month).
ODDS_API_KEY=
ODDS_REGIONS=us

# ---- Season ----
# Leave blank to derive automatically (NFL seasons are labelled by the year they start).
SEASON=
# Seasons of play-by-play used to fit the model. More is steadier but slower on
# first boot — each season is roughly a 19MB download.
CALIBRATION_SEASONS=6
HISTORY_SEASONS=3

# ---- Risk defaults ----
DEFAULT_BANKROLL=1000
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.05
MAX_EXPOSURE_PER_GAME_PCT=0.10
MAX_EXPOSURE_PER_TEAM_PCT=0.15
MAX_DAILY_EXPOSURE_PCT=0.20

# ---- Edge thresholds ----
MIN_EV=0.04
MIN_EDGE=0.015
LONGSHOT_FLOOR=0.08
HEAVY_FAV_CAP=0.92
MAX_QUOTE_SPREAD=0.12

# ---- Background jobs ----
JOBS_ENABLED=true
MARKET_SNAPSHOT_INTERVAL=600
GRADING_INTERVAL=1800

# ---- Misc ----
LOG_LEVEL=INFO
# Signing secret for login cookies. Leave blank to generate and persist one.
SITE_SECRET=
