# Copy this file to .env and fill in your keys.
# The app runs fully in DEMO mode without any keys.

# Get a free key at https://the-odds-api.com (500 requests/month free).
ODDS_API_KEY=

# Set to false once you add a real key to pull live odds.
DEMO_MODE=true

# Default bankroll used for stake sizing suggestions (in dollars).
DEFAULT_BANKROLL=1000

# Fraction of full Kelly to recommend (0.5 = half-Kelly, the disciplined default).
KELLY_FRACTION=0.5
